{
  // Must match the Worker name shown in your Cloudflare dashboard.
  "name": "primecoat-interiors",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // The website (public pages, images, admin page).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Where posts, photos and videos are stored.
  // Replace the id with YOUR namespace id: Workers & Pages > KV > primecoat > copy the ID.
  "kv_namespaces": [
    { "binding": "KV", "id": "PASTE_YOUR_KV_NAMESPACE_ID_HERE" }
  ],

  // Keep settings you add in the dashboard (like your secrets) when deploying.
  "keep_vars": true
}
